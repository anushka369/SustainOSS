# Application
NODE_ENV=development
PORT=3000
API_KEY=your-api-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Database - PostgreSQL (Document Store)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sustainoss
DB_USER=postgres
DB_PASSWORD=postgres

# Database - TimescaleDB (Time Series)
# If using separate TimescaleDB instance, configure these
# Otherwise, it will use the same PostgreSQL instance above
TIMESERIES_DB_HOST=localhost
TIMESERIES_DB_PORT=5432
TIMESERIES_DB_NAME=sustainoss

# Redis (Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
ENABLE_HTTPS=false
CORS_ORIGINS=http://localhost:5173
